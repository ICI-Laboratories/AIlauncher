# Alternative to the existing host inference; do not run both on the same GPUs.
LLM_DOCKER_NETWORK=llm-apps
LLM_BACKEND_NETWORK=llm-backend
MODEL_BACKEND_URL=http://inference-nvidia:8080/v1
MODEL_BACKEND_MODEL=qwen-local
APP_KEYS_HOST_FILE=/etc/ailauncher/app-keys.json
# Replace tag with a tested digest for production.
LLAMA_CUDA_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda
MODELS_DIR=/srv/models
MODEL_FILE=model.gguf
MMPROJ_FILE=mmproj.gguf
CUDA_VISIBLE_DEVICES=0,1
# Starting allocation for 24 GB + 12 GB, not a performance guarantee.
NVIDIA_TENSOR_SPLIT=2,1
ENGINE_CONTEXT_TOKENS=32768
MAX_CONTEXT_TOKENS=8192
MAX_INFLIGHT=4
MAX_QUEUE=32
PER_APP_INFLIGHT=2
MAX_OUTPUT_TOKENS=2048
