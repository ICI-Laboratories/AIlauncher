# Host-engine deployment. Copy outside the repository, e.g. /etc/ailauncher/gateway.env.
# Compose paths are relative to compose.shared.yml; use absolute paths here.
LLM_DOCKER_NETWORK=llm-apps
LLM_BACKEND_NETWORK=llm-backend
MODEL_BACKEND_URL=http://172.30.81.1:8080/v1
MODEL_BACKEND_MODEL=qwen-local
MODEL_ALIASES=qwen-local,sara-main,local-model
APP_KEYS_HOST_FILE=/etc/ailauncher/app-keys.json
GATEWAY_PORT=8009
MAX_INFLIGHT=4
MAX_QUEUE=32
PER_APP_INFLIGHT=2
QUEUE_TIMEOUT_SECONDS=60
REQUEST_TIMEOUT_SECONDS=300
MAX_OUTPUT_TOKENS=2048
MAX_BODY_BYTES=16777216
MAX_CONTEXT_TOKENS=8192

# Phase 2: keep these disabled until each auxiliary llama.cpp instance is tested.
# These settings only configure the gateway; they do not start/download models.
OCR_ENABLED=false
OCR_BACKEND_URL=
OCR_BACKEND_MODEL=
OCR_MODEL_ALIASES=ocr
OCR_MAX_INFLIGHT=1
OCR_MAX_QUEUE=8
OCR_PER_APP_INFLIGHT=1
OCR_QUEUE_TIMEOUT_SECONDS=30
OCR_REQUEST_TIMEOUT_SECONDS=120
OCR_MAX_OUTPUT_TOKENS=4096
OCR_MAX_CONTEXT_TOKENS=8192
OCR_MAX_BODY_BYTES=16777216
OCR_MAX_IMAGE_BYTES=8388608
OCR_MAX_IMAGE_SIDE=2048
OCR_MAX_INPUT_CHARS=8192
OCR_MAX_TOTAL_INPUT_CHARS=65536

EMBEDDINGS_ENABLED=false
EMBEDDINGS_BACKEND_URL=
EMBEDDINGS_BACKEND_MODEL=
EMBEDDINGS_MODEL_ALIASES=bge-m3
EMBEDDINGS_MAX_INFLIGHT=1
EMBEDDINGS_MAX_QUEUE=8
EMBEDDINGS_PER_APP_INFLIGHT=1
EMBEDDINGS_QUEUE_TIMEOUT_SECONDS=30
EMBEDDINGS_REQUEST_TIMEOUT_SECONDS=120
EMBEDDINGS_MAX_BODY_BYTES=1048576
EMBEDDINGS_MAX_BATCH_SIZE=16
EMBEDDINGS_MAX_INPUT_CHARS=8192
EMBEDDINGS_MAX_TOTAL_INPUT_CHARS=65536
EMBEDDINGS_DIMENSIONS=1024
