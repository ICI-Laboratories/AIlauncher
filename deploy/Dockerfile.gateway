FROM python:3.11-slim

WORKDIR /app
COPY pyproject.toml README.md ./
COPY lmserv ./lmserv
RUN pip install --no-cache-dir . && useradd --uid 10001 --no-create-home gateway

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
USER 10001:10001
EXPOSE 8000
CMD ["python", "-m", "uvicorn", "lmserv.server.shared_api:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--no-access-log"]
