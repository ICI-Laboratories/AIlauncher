# Alternative to host inference; not validated on the future AMD hardware.
LLM_DOCKER_NETWORK=llm-apps
LLM_BACKEND_NETWORK=llm-backend
MODEL_BACKEND_URL=http://inference-amd:8080/v1
MODEL_BACKEND_MODEL=qwen-local
APP_KEYS_HOST_FILE=/etc/ailauncher/app-keys.json
# Replace tag with a tested digest after GPU/ROCm/model compatibility validation.
LLAMA_ROCM_IMAGE=ghcr.io/ggml-org/llama.cpp:server-rocm
MODELS_DIR=/srv/models
MODEL_FILE=model.gguf
MMPROJ_FILE=mmproj.gguf
HIP_VISIBLE_DEVICES=0,1,2,3,4,5,6,7
AMD_TENSOR_SPLIT=1,1,1,1,1,1,1,1
# Set numeric group IDs from the target host: getent group video render
AMD_VIDEO_GID=44
AMD_RENDER_GID=109
ENGINE_CONTEXT_TOKENS=32768
MAX_CONTEXT_TOKENS=8192
MAX_INFLIGHT=4
MAX_QUEUE=32
PER_APP_INFLIGHT=2
MAX_OUTPUT_TOKENS=2048
